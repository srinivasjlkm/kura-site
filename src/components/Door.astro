---
// W2 opening: the studio's red front door, with KURA across it. Scrolling opens the two leaves
// and shows a project behind. Without scripts or with reduced motion the door simply stays shut
// and the project follows below it, so nothing is hidden.
import Pic from './Pic.astro';
import { url } from '../data/load.js';
const { hero } = Astro.props;
const face = (
  `<span class="door-word" aria-hidden="true">KURA</span>` +
  `<span class="door-sub" aria-hidden="true"><span>Design</span><span>Studio</span></span>`
);
---
<section class="door" data-door aria-label="Kura Design Studio">
  <div class="door-stage">
    <figure class="door-view">
      <a href={url(`work/${hero.slug}/`)} tabindex="-1"><Pic image={hero.images[0]} alt={hero.title} sizes="90vw" eager /></a>
      <figcaption><a href={url(`work/${hero.slug}/`)}>{hero.title}</a><span>{hero.location}</span></figcaption>
    </figure>
    <div class="leaf leaf-l"><div class="leaf-face" set:html={face} /></div>
    <div class="leaf leaf-r"><div class="leaf-face" set:html={face} /></div>
    <h1 class="sr">Kura Design Studio</h1>
    <p class="door-hint" aria-hidden="true">Scroll to open</p>
  </div>
</section>

<script>
  const door = document.querySelector<HTMLElement>('[data-door]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  if (door && !still.matches) {
    door.classList.add('is-live');
    document.documentElement.classList.add('has-door');
    let queued = false;
    const draw = () => {
      queued = false;
      const run = door.offsetHeight - innerHeight;
      const raw = Math.min(1, Math.max(0, -door.getBoundingClientRect().top / (run * 0.8)));
      const p = raw < 0.5 ? 2 * raw * raw : 1 - (-2 * raw + 2) ** 2 / 2;
      door.style.setProperty('--p', p.toFixed(4));
      document.documentElement.classList.toggle('door-open', p > 0.85);
    };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', ask);
    draw();
  }
</script>

---
import Base from '../layouts/Base.astro';
import { site } from '../data/load.js';
const { fields, paragraphs } = site.studio;
const services = (fields.services || '').split(',').map((s) => s.trim()).filter(Boolean);
---
<Base title="Studio" description={paragraphs[0] || ''}>
  <div class="wrap">
    <h1 class="page-title">Studio</h1>
    <div class="grid"><div class="studio-text">{paragraphs.map((t) => <p>{t}</p>)}</div></div>
    {site.people.length > 0 && (
      <section class="section grid">
        <h2 class="h-section">Partners</h2>
        <div class="rows">{site.people.map((p) => (
          <div class="row"><div><h3>{p.name}</h3><p class="muted">{p.role}</p></div><div>{p.paragraphs.map((t) => <p>{t}</p>)}</div></div>
        ))}</div>
      </section>
    )}
    {services.length > 0 && (
      <section class="section grid">
        <h2 class="h-section">Services</h2>
        <ul class="rows">{services.map((s) => <li class="row"><h3>{s}</h3><span></span></li>)}</ul>
      </section>
    )}
  </div>
</Base>
